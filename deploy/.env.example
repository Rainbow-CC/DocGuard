# Docker network exposure. Keep 127.0.0.1 when using an Nginx/Caddy reverse proxy.
DOCGUARD_BIND_ADDRESS=127.0.0.1
DOCGUARD_PORT=8000

# Single-machine Linux paths. All persistent application state lives in ./runtime on the host.
DOCGUARD_PREPROCESS_COMMAND=bash
# Leave empty in this Docker deployment. It is only used by the Windows host
# development flow that invokes WSL through wsl.exe.
DOCGUARD_WSL_DISTRIBUTION=
DOCGUARD_DATABASE_PATH=/var/lib/docguard/docguard.sqlite3
DOCGUARD_LOG_FILE=/var/lib/docguard/logs/docguard.log
DOCGUARD_LOG_LEVEL=INFO
DOCGUARD_LOG_RETENTION_DAYS=14
DOCGUARD_RESULT_WRITE_ROOT=/var/lib/docguard/results
DOCGUARD_RESULT_AGENT_ROOT=/var/lib/docguard/results
DOCGUARD_UPLOAD_WRITE_ROOT=/var/lib/docguard/uploads
DOCGUARD_UPLOAD_AGENT_ROOT=/var/lib/docguard/uploads
DOCGUARD_UPLOAD_MAX_BYTES=104857600
DOCGUARD_SKILL_AGENT_ROOT=/app/doc-audit-integrate-skill
# Development-only: exporting a trajectory requires the host-side WSL helper,
# so keep this disabled for the Docker deployment.
DOCGUARD_ACTION_CHAIN_EXPORT_ENABLED=false

# Required when visual review is enabled.
DASHSCOPE_API_KEY=
DOCGUARD_QWEN_BASE_URL=https://llm-qk9l4nr6p8kz0huk.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DOCGUARD_QWEN_VISION_MODEL=qwen3.7-flash

# Docker-managed OpenClaw Gateway. These values are required when an audit task
# uses agent_backend=openclaw.
OPENCLAW_GATEWAY_URL=http://openclaw:18789/v1
# Use a newly generated, Docker-Gateway-only value. Compose forwards it to the
# Gateway as OPENCLAW_GATEWAY_TOKEN; do not set a second token variable.
OPENCLAW_API_TOKEN=OPENCLAW_DOCGUARD_001
# Dedicated Docker Gateway state. Do not point this at ~/.openclaw when a
# native OpenClaw installation must remain independent.
OPENCLAW_HOST_HOME=/home/ubuntu/.openclaw-docguard
# Required by the audit-runtime model when using MiniMax.
MINIMAX_API_KEY=
# Absolute Linux host paths. They are mounted into the Gateway at the same paths
# so it can create the sibling audit sandbox through the Docker socket.
DOCGUARD_REPO_HOST=/home/ubuntu/docguard-deploy-test/DocGuard
DOCGUARD_RUNTIME_HOST=/home/ubuntu/docguard-deploy-test/DocGuard/deploy/runtime
# Required for access to /var/run/docker.sock. Fill with:
# stat -c '%g' /var/run/docker.sock
DOCKER_GID=1001
