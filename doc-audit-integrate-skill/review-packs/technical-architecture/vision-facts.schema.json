{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VisualFacts",
  "description": "A minimal, diagram-type-neutral envelope. The facts object is intentionally flexible so the visual model can use fields appropriate to the image.",
  "type": "object",
  "required": ["diagram_type", "diagram_scope", "facts", "explicit_relations", "uncertainties"],
  "properties": {
    "diagram_type": {
      "enum": ["architecture", "deployment", "network", "data_flow", "process", "data_model", "table_or_matrix", "unknown"]
    },
    "diagram_scope": {
      "type": "string",
      "description": "A concise statement of what the image mainly depicts."
    },
    "facts": {
      "type": "object",
      "description": "Diagram-type-specific visual facts. Use clear English snake_case field names; values may be nested JSON objects or arrays.",
      "additionalProperties": true
    },
    "explicit_relations": {
      "type": "array",
      "description": "Only relationships represented by an explicit visible line, arrow, interface symbol, or connector.",
      "items": {
        "type": "object",
        "required": ["source", "target", "direction", "label", "evidence"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "direction": {"enum": ["source_to_target", "target_to_source", "bidirectional", "unknown"]},
          "label": {"type": ["string", "null"]},
          "evidence": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "reason"],
        "properties": {
          "subject": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
