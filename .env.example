
# OpenClaw connection. Do not commit actual secrets.
OPENCLAW_GATEWAY_URL=
OPENCLAW_API_TOKEN=

# Visual review. The base URL and model are optional overrides.
DASHSCOPE_API_KEY=
# DOCGUARD_QWEN_BASE_URL=https://llm-qk9l4nr6p8kz0huk.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DOCGUARD_QWEN_VISION_MODEL=qwen3.7-flash

# Windows / WSL-specific paths. Replace Ubuntu and the host paths for your machine.
DOCGUARD_PREPROCESS_COMMAND=wsl.exe
DOCGUARD_WSL_DISTRIBUTION=Ubuntu
DOCGUARD_RESULT_WRITE_ROOT=\\wsl.localhost\Ubuntu\home\ubuntu\docguard-results
DOCGUARD_RESULT_AGENT_ROOT=/home/ubuntu/docguard-results
DOCGUARD_UPLOAD_WRITE_ROOT=\\wsl.localhost\Ubuntu\home\ubuntu\docguard-inbox
DOCGUARD_UPLOAD_AGENT_ROOT=/home/ubuntu/docguard-inbox
DOCGUARD_SKILL_AGENT_ROOT=/mnt/c/path/to/DocGuard/doc-audit-integrate-skill

# Optional operational settings. Omit to use portable code defaults.
# DOCGUARD_DATABASE_PATH=data/docguard.sqlite3
# DOCGUARD_LOG_LEVEL=INFO
# DOCGUARD_LOG_FILE=logs/docguard.log
# DOCGUARD_LOG_RETENTION_DAYS=14
DOCGUARD_UPLOAD_MAX_BYTES=104857600
# DOCGUARD_ACTION_CHAIN_EXPORT_ENABLED=false
