# Select the agent executor used by newly created tasks.
DOCGUARD_DEFAULT_AGENT_BACKEND=stub

# Future production adapters. Do not commit actual secrets.
OPENCLAW_GATEWAY_URL=
OPENCLAW_API_TOKEN=
LANGCHAIN_MODEL=

# Agent result artifacts. The two paths refer to the same shared WSL directory.
DOCGUARD_RESULT_WRITE_ROOT=\\wsl.localhost\Ubuntu\home\ubuntu\docguard-results
DOCGUARD_RESULT_AGENT_ROOT=/home/ubuntu/docguard-results

# DOCX upload storage. Windows development writes to WSL; OpenClaw receives the Linux path.
DOCGUARD_UPLOAD_WRITE_ROOT=\\wsl.localhost\Ubuntu\home\ubuntu\docguard-inbox
DOCGUARD_UPLOAD_AGENT_ROOT=/home/ubuntu/docguard-inbox
DOCGUARD_UPLOAD_MAX_BYTES=104857600
